# ==============================================================================
# CLUSTERSAGE — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the services:
#   cp .env.example .env
#
# IMPORTANT SECURITY NOTICE:
# - Variables prefixed with NEXT_PUBLIC_ are baked into the frontend client bundle.
# - NEVER prefix private secrets (e.g. GEMINI_API_KEY, private tokens) with NEXT_PUBLIC_.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI Reasoning Engine (Server-Only, Confidential)
# ------------------------------------------------------------------------------
# Required for autonomous SRE root cause analysis and manifest audits.
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Reasoning model identifier (gemini-2.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. InsForge BaaS & Authentication (Authentication & Persistent Database)
# ------------------------------------------------------------------------------
# InsForge backend URL for OAuth, JWT authentication, and investigations storage
INSFORGE_URL=https://mucsd7yw.us-east.insforge.app

# Public client-safe anonymous API key
INSFORGE_ANON_KEY=anon_57cbe317689f3e724ced0051c10d088eab9ddc1123ce564702735a7dcb764eb8

# ------------------------------------------------------------------------------
# 3. Hindsight Episodic Memory Engine (Cross-Incident Incident Learning)
# ------------------------------------------------------------------------------
# Hindsight API endpoint (use http://hindsight:8888 inside Docker network)
HINDSIGHT_URL=http://localhost:8888

# Hindsight Control Plane Web Dashboard URL
HINDSIGHT_CONTROL_PLANE_URL=http://localhost:9999

# LLM provider for Hindsight memory synthesis ('gemini' or 'mock' for offline testing)
HINDSIGHT_API_LLM_PROVIDER=gemini
HINDSIGHT_API_LLM_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. Backend Service Configuration (Server-Only)
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Optional: Path to custom Kubeconfig if not mounted at ~/.kube/config
KUBECONFIG_PATH=

# ------------------------------------------------------------------------------
# 5. Frontend Public Configuration (Browser-Accessible)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_INSFORGE_URL=https://mucsd7yw.us-east.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=anon_57cbe317689f3e724ced0051c10d088eab9ddc1123ce564702735a7dcb764eb8
NEXT_PUBLIC_HINDSIGHT_CONTROL_PLANE=http://localhost:9999

# ------------------------------------------------------------------------------
# 6. Remote GitOps & GitHub Integration (Optional)
# ------------------------------------------------------------------------------
# Optional GitHub Personal Access Token for auditing private repos or higher API rate limits
GITHUB_TOKEN=
